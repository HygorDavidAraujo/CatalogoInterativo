# ===== BANCO DE DADOS POSTGRESQL (NEON) =====
# Use a URL pooled do Neon na aplicação/Vercel.
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.region.aws.neon.tech/catalogo?sslmode=require

# Apenas para executar a migração de dados uma vez a partir do MySQL antigo.
MYSQLHOST=mysql-antigo.example.com
MYSQLUSER=usuario_de_migracao
MYSQLPASSWORD=senha_rotacionada
MYSQLDATABASE=railway
MYSQLPORT=3306

# ===== SEGURANÇA =====
# IMPORTANTE: Gere uma chave forte em produção!
# Você pode gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET

# ===== CLOUDINARY (Upload de Imagens) =====
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# ===== REDIS (Cache - Opcional) =====
# Se não configurado, a aplicação funcionará sem cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== AMBIENTE =====
# development | production
NODE_ENV=development

# ===== SERVIDOR =====
PORT=3000

# ===== LOGGING =====
# error | warn | info | http | debug
LOG_LEVEL=info

# ===== E-MAIL / RESEND (recomendado para produção) =====
# Crie uma chave em https://resend.com e configure o domínio verificado
APP_URL=https://seu-dominio.vercel.app
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Davini Vinhos <onboarding@resend.dev>"

# ===== E-MAIL / SMTP (fallback, caso queira manter o Gmail) =====
# Use App Password gerado na conta Google (não a senha normal)
SMTP_USER=seu-email@example.com
SMTP_PASS=__COLE_AQUI_O_APP_PASSWORD__
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM="Davini Vinhos <noreply@example.com>"

# JWT_SECRET já foi definido acima (mantenha seguro)
